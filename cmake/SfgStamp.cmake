# SculptForgeG build stamp (the fork's own version): "<emoji> <CODEWORD> · <sha6> · <date>", derived from the
# commit exactly as the portfolio build-stamp standard (_agent-commons/reference/build-stamp-standard.md):
#   emoji    = EMOJI_LIST[ int(sha[0:8],16) % 128 ]     (cmake/sfg-emoji.txt, frozen)
#   codeword = upper(WORD_LIST[ int(sha[8:16],16) % 1024 ])  (cmake/sfg-words.txt, frozen BIP-39 first 1024)
# Without git (a tarball) the stamp reads "dev".
function(sfg_write_stamp_header out)
  set(sha "")
  set(date "")
  find_package(Git QUIET)
  if(GIT_FOUND AND EXISTS ${CMAKE_SOURCE_DIR}/.git)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
                    OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${GIT_EXECUTABLE} show -s --format=%cd --date=short HEAD WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
                    OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  set(SFG_EMOJI "")
  set(SFG_CODEWORD "DEV")
  set(SFG_SHA6 "dev")
  set(SFG_DATE "${date}")
  string(LENGTH "${sha}" sha_len)
  if(sha_len EQUAL 40 AND sha MATCHES "^[0-9a-f]+$") # (CMake regexes have no {n})
    string(SUBSTRING "${sha}" 0 8 h1)
    string(SUBSTRING "${sha}" 8 8 h2)
    math(EXPR ei "0x${h1} % 128")
    math(EXPR wi "0x${h2} % 1024")
    file(STRINGS ${CMAKE_SOURCE_DIR}/cmake/sfg-emoji.txt emoji_list ENCODING UTF-8)
    file(STRINGS ${CMAKE_SOURCE_DIR}/cmake/sfg-words.txt word_list)
    list(GET emoji_list ${ei} SFG_EMOJI)
    list(GET word_list ${wi} word)
    string(TOUPPER "${word}" SFG_CODEWORD)
    string(SUBSTRING "${sha}" 0 6 SFG_SHA6)
  endif()
  set(SFG_BASED_ON "SculptForge ${PROJECT_VERSION}")
  file(WRITE ${out}.tmp
"// Generated by cmake/SfgStamp.cmake: SculptForgeG's own build stamp.
#pragma once
#define SFG_STAMP_EMOJI \"${SFG_EMOJI}\"
#define SFG_STAMP_CODEWORD \"${SFG_CODEWORD}\"
#define SFG_STAMP_SHA \"${SFG_SHA6}\"
#define SFG_STAMP_DATE \"${SFG_DATE}\"
#define SFG_BASED_ON \"${SFG_BASED_ON}\"
")
  configure_file(${out}.tmp ${out} COPYONLY)
  message(STATUS "SculptForgeG stamp: ${SFG_EMOJI} ${SFG_CODEWORD} · ${SFG_SHA6} · ${SFG_DATE} (based on ${SFG_BASED_ON})")
endfunction()
